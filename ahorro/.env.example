# Copia este archivo como .env.local y rellénalo con los datos de TU proyecto de Supabase
# (supabase.com → tu proyecto → Project Settings → API).
# Las dos son públicas por diseño: van dentro de la app. Lo que protege los datos son las
# reglas de acceso de la base de datos (Row Level Security), no estas claves.
# NUNCA pongas aquí la clave "service_role" ni la "secret": esas no deben salir de Supabase.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
